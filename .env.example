# GroundedPDF server
GROUNDEDPDF_ENVIRONMENT=development
GROUNDEDPDF_DATA_DIR=./data
GROUNDEDPDF_DATABASE_URL=sqlite:///./data/groundedpdf.db
GROUNDEDPDF_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
GROUNDEDPDF_MAX_UPLOAD_MB=50
GROUNDEDPDF_MAX_UPLOAD_BATCH_MB=200
GROUNDEDPDF_MAX_UPLOAD_FILES=20
GROUNDEDPDF_RATE_LIMIT_PER_MINUTE=60
GROUNDEDPDF_ENABLE_OCR=false

# Local embeddings and retrieval
GROUNDEDPDF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GROUNDEDPDF_CHUNK_SIZE=900
GROUNDEDPDF_CHUNK_OVERLAP=150
GROUNDEDPDF_RETRIEVAL_COUNT=6
GROUNDEDPDF_RETRIEVAL_MIN_SCORE=0.15
GROUNDEDPDF_RETRIEVAL_SEMANTIC_CONFIDENCE_SCORE=0.45

# Chat provider: ollama, openai_compatible, or mock (testing only)
GROUNDEDPDF_MODEL_PROVIDER=ollama
GROUNDEDPDF_MODEL_NAME=llama3.2:3b
GROUNDEDPDF_OLLAMA_BASE_URL=http://localhost:11434
GROUNDEDPDF_OPENAI_BASE_URL=http://localhost:8001/v1
GROUNDEDPDF_OPENAI_API_KEY=
GROUNDEDPDF_TEMPERATURE=0.1
GROUNDEDPDF_MAX_OUTPUT_TOKENS=800
GROUNDEDPDF_MODEL_TIMEOUT_SECONDS=120

# Container-to-host provider endpoints. These deliberately differ from the local URLs above.
GROUNDEDPDF_DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
GROUNDEDPDF_DOCKER_OPENAI_BASE_URL=http://host.docker.internal:8001/v1
# Keep this comfortably above GROUNDEDPDF_MAX_UPLOAD_BATCH_MB for multipart temp files.
GROUNDEDPDF_UPLOAD_TMPFS_MB=256

# Web build/development
VITE_API_BASE_URL=http://localhost:8000/api/v1
